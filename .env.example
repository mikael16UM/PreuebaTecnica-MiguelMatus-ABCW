# Copia este archivo a ".env" y ajústalo si quieres.
#   cp .env.example .env

PORT=3000

# Ruta del archivo SQLite (ya viene configurada, no necesitas tocarla).
DATABASE_PATH=./db/app.sqlite

# Credenciales para la vista de administración.
# Úsalas cuando implementes la autenticación del panel.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
